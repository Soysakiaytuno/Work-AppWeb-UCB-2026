# ==============================================================================
# CONFIGURACIÓN DE EJEMPLO - LA CARTA 2.0 (ISW-233)
# Copia este archivo como .env y completa los valores correspondientes
# ==============================================================================

# 1. Base de Datos (PostgreSQL 16)
POSTGRES_USER=app
POSTGRES_PASSWORD=tu_password_segura_aqui
POSTGRES_DB=restaurant_database
DATABASE_URL=postgresql+psycopg2://app:tu_password_segura_aqui@db:5432/restaurant_database

# 2. Seguridad Flask
SECRET_KEY=clave-secreta-aleatoria-y-segura-para-flask
FLASK_DEBUG=0
BEHIND_PROXY=1

# 3. Auth0 (Tenant & API)
AUTH0_DOMAIN=tu-tenant.us.auth0.com
API_AUDIENCE=https://carta-api
AUTH0_CLIENT_ID=tu_regular_web_app_client_id
AUTH0_CLIENT_SECRET=tu_client_secret_de_auth0
ALGORITHMS=RS256

# 4. Django Backoffice
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOST=admin.localhost
